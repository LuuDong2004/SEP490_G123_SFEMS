# Cấu hình riêng của máy mình. Chép file này thành backend/.env rồi điền — .env đã gitignore,
# không bao giờ commit. Mỗi dòng KEY=VALUE cấp giá trị cho ${KEY:mặc-định} trong
# src/main/resources/application.properties; bỏ trống / xoá dòng thì dùng mặc định.
# Cần giá trị khác thì thêm dòng ở đây, KHÔNG sửa application.properties.

# --- PostgreSQL ---------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/sfems
DB_USERNAME=postgres
DB_PASSWORD=123
# DB_POOL_SIZE=20

# --- Web ----------------------------------------------------------------------
# Cổng backend; frontend mặc định gọi http://localhost:8888/api (frontend/.env VITE_API_URL).
SERVER_PORT=8888

# --- MinIO (tệp đính kèm) -------------------------------------------------------
# Mặc định khớp backend/compose.yaml: docker compose -f backend/compose.yaml up -d minio
# APP_STORAGE_ENDPOINT=http://localhost:9100
# APP_STORAGE_ACCESS_KEY=sfems
# APP_STORAGE_SECRET_KEY=sfems-dev-secret
# APP_STORAGE_BUCKET=sfems-attachments

# --- SMTP (mã xác thực hai bước, đặt lại mật khẩu) -----------------------------
# Không khai thì thư chỉ ghi ra log, vẫn thử được luồng đăng nhập. Khai bằng khoá dạng chấm:
# spring.mail.host=smtp.gmail.com
# spring.mail.port=587
# spring.mail.username=
# spring.mail.password=
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true
# app.mail.from=no-reply@sfems.local

# --- Khác ---------------------------------------------------------------------
# APP_SECURITY_JWT_SECRET=   # chỉ cần trên máy chủ; dev dùng khoá mặc định
# APP_API_DOCS=true          # /swagger-ui.html
# REDIS_HOST=                # trống = không dùng Redis
