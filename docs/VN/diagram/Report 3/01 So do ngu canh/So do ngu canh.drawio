<mxfile host="drawio"><diagram id="d" name="So do ngu canh"><mxGraphModel grid="0" page="0" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:28px&quot;&gt;SFEMS&lt;/b&gt;&lt;br&gt;Hệ thống quản lý&lt;br&gt;cơ sở vật chất và&lt;br&gt;thiết bị trường học" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F3F6FC;strokeColor=#1F3A68;strokeWidth=2.5;fontSize=18;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="875.0" y="525.0" width="350.0" height="350.0" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Quản trị viên&lt;br&gt;hệ thống&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.8;fontSize=17;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="935.0" y="40.0" width="230.0" height="86.0" as="geometry"/></mxCell><mxCell id="c4" value="" style="endArrow=block;endFill=1;endSize=9;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1036.0" y="126.0" as="sourcePoint"/><mxPoint x="1036.0" y="525.6" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="Tài khoản, vai trò và quyền&lt;br&gt;Luồng phê duyệt, quy tắc sinh mã&lt;br&gt;Thiết lập thông báo và dịch vụ AI" style="text;html=1;whiteSpace=nowrap;verticalAlign=middle;fontSize=15;fontFamily=Arial;strokeColor=none;fillColor=none;align=right;" vertex="1" parent="1"><mxGeometry x="764.5" y="138.0" width="261.5" height="66.0" as="geometry"/></mxCell><mxCell id="c6" value="" style="endArrow=block;endFill=1;endSize=9;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1064.0" y="525.6" as="sourcePoint"/><mxPoint x="1064.0" y="126.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c7" value="Dữ liệu, báo cáo toàn hệ thống&lt;br&gt;(chỉ xem)" style="text;html=1;whiteSpace=nowrap;verticalAlign=middle;fontSize=15;f