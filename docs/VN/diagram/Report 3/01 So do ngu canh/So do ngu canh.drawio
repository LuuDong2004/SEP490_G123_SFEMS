olor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="875.5" y="713.0" as="sourcePoint"/><mxPoint x="230.0" y="713.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="Danh mục, danh mục tối thiểu, định mức&lt;br&gt;Hồ sơ trường, chuẩn cơ sở vật chất&lt;br&gt;Kế hoạch mua sắm&lt;br&gt;Đợt kiểm kê&lt;br&gt;Tệp dữ liệu thiết bị ban đầu" style="text;html=1;whiteSpace=nowrap;verticalAlign=middle;fontSize=15;fontFamily=Arial;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="403.2" y="575.0" width="299.0" height="106.0" as="geometry"/></mxCell><mxCell id="c22" value="Đề xuất mua sắm đã duyệt&lt;br&gt;Tiến độ kiểm kê các trường&lt;br&gt;Báo cáo tổng hợp toàn thành phố" style="text;html=1;whiteSpace=nowrap;verticalAlign=middle;fontSize=15;fontFamily=Arial;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="429.5" y="719.0" width="246.5" height="66.0" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;MinIO&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.8;fontSize=17;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="0.0" y="997.0" width="230.0" height="86.0" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=block;endFill=1;endSize=9;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="230.0" y="1027.0" as="sourcePoint"/><mxPoint x="912.1" y="807.7" as="targetPoint"/><Array as="points"><mxPoint x="912.1" y="1027.0"/></Array></mxGeometry></mxCell><mxCell id="c25" value="" style="endArrow=block;endFill=1;endSize=9;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="957.3" y="848.4" as="sourcePoint"/><mxPoint x="230.0" y="1053.0" as="targetPoint"/><Array as="points"><mxPoint x="957.3" y="1053.0"/></Array></mxGeometry></mxCell><mxCell id="c26" value="Nội dung tệp đính kèm" style="text;html=1;whiteSpace=nowrap;verticalAlign=middle;fontSize=15;fontFamily=Arial;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="485.3" y="995.0" width="171.5" height="26.0" as="geometry"/></mxCell><mxCell id="c27" value="Tệp đính kèm cần lưu" style="text;html=1;whiteSpace=nowrap;verticalAlign=middle;fontSize=15;fontFamily=Arial;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="489.0" y="1059.0" width="164.0" height="26.0" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Lãnh đạo trường&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.8;fontSize=17;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1870.0" y="317.0" width="230.0" height="86.0" as="geometry"/></mxCell><mxCell id="c29" value="" style="endArrow=block;endFill=1;endSize=9;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1870.0" y="347.0" as="sourcePoint"/><mxPoint x="1142.7" y="551.6" as="targetPoint"/><Array as="points"><mxPoint x="1142.7" y="347.0"/></Array></mxGeometry></mxCell><mxCell id="c30" value="" style="endArrow=block;endFill=1;endSize=9;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1187.9" y="592.3" as="sourcePoint"/><mxPoint x="1870.0" y="373.0" as="targetPoint"/><Array as="points"><mxPoint x="1187.9" y="373.0"/></Array></mxGeometry></mxCell><mxCell id="c31" value="Quyết định duyệt đề xuất, phiếu ghi tăng,&lt;br&gt;biên bản kiểm kê&lt;br&gt;Nhân sự, tài khoản cán bộ" style="text;html=1;whiteSpace=nowrap;verticalAlign=middle;fontSize=15;fontFamily=Arial;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1379.5" y="275.0" width="299.0" height="66.0" as="geometry"/></mxCell><mxCell id="c32" value="Đề xuất, phiếu ghi tăng, biên bản chờ duyệt&lt;br&gt;Báo cáo, kết quả đánh giá cơ sở vật chất" style="text;html=1;whiteSpace=nowrap;verticalAlign=middle;fontSize=15;fontFamily=Arial;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1372.0" y="379.0" width="314.0" height="46.0" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Cán bộ thiết bị&lt;br&gt;trường&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.8;fontSize=17;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1870.0" y="657.0" width="230.0" height="86.0" as="geometry"/></mxCell><mxCell id="c34" value="" style="endArrow=block;endFill=1;endSize=9;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1870.0" y="687.0" as="sourcePoint"/><mxPoint x="1224.5" y="687.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="" style="endArrow=block;endFill=1;endSize=9;html=1;rounded=0;strokeWidth=1.5;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1224.5" y="713.0" as="sourcePoint"/><mxPoint x="1870.0" y="713.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="Đề xuất mua sắm&lt;br&gt;Phiếu ghi tăng thiết bị&lt;br&gt;Phiếu kiểm kê, kết quả kiểm đếm&lt;br&gt;Cơ sở, phòng, lớp, nhân sự&lt;br&gt;Tệp dữ liệu thiết bị ban đầu" style="text;html=1;whiteSpace=nowrap;verticalAlign=middle;fontSize=15;fontFamily=Arial;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1420.3" y="575.0" width="254.0" height="106.0" as="geometry"/></mxCell><mxCell id="c37" value="Mức đáp ứng danh mục tối thiểu&lt;br&gt;Hồ sơ thiết bị, mã thiết bị&lt;br&gt;Biên bản kiểm kê" style="text;html=1;whiteSpace=nowrap;verticalAlign=middle;fontSize=15;fontFamily=Arial;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1"><mxGeometry x="1424.0" y="719.0" width="246.5" height="66.0" as="geometry"/></mxCell><mxCel