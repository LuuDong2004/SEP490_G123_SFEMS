Size=8;strokeWidth=1.4;strokeColor=#000000;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c104" target="c105"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c109" value="Nhập dữ liệu đầu vào" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1450.0" y="738.0" width="190.0" height="72.0" as="geometry"/></mxCell><mxCell id="c110" value="Lô nhập dữ liệu&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;(sửa trên lưới, ghi, hoàn tác)&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1450.0" y="860.0" width="190.0" height="72.0" as="geometry"/></mxCell><mxCell id="c111" value="Người dùng" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1680.0" y="738.0" width="190.0" height="72.0" as="geometry"/></mxCell><mxCell id="c112" value="Thêm / Sửa / Chi tiết&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;người dùng&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1680.0" y="860.0" width="190.0" height="72.0" as="geometry"/></mxCell><mxCell id="c113" value="Vai trò, Quyền" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1910.0" y="738.0" width="190.0" height="72.0" as="geometry"/></mxCell><mxCell id="c114" value="Thêm / Sửa / Chi tiết&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;vai trò, chi tiết quyền&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1910.0" y="860.0" width="190.0" height="72.0" as="geometry"/></mxCell><mxCell id="c115" value="Tài khoản của trường" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1450.0" y="982.0" width="190.0" height="72.0" as="geometry"/></mxCell><mxCell id="c116" value="Cấu hình&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;luồng phê duyệt, mã tự tăng của trường,&lt;br&gt;quy tắc sinh mã, cài đặt thông báo&lt;/span&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontSize=16;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1680.0" y="982.0" width="420.0" height="72.0" as="geometry"/></mxCell><mxCell id="c117" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.4;strokeColor=#000000;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c109" target="c110"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c118" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.4;strokeColor=#000000;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c111" target="c112"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c119" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=1.4;strokeColor=#000000;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c113" target="c114"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c120" value="Ghi chú: mũi tên = mở màn hình kế tiếp. “(Sở)” = chỉ cơ quan quản lý thấy. Ghi tăng và Kiểm kê là thẻ của nhóm Thiết bị trên thanh bên của trường. Với Sở, Kiểm kê là nhóm riêng. Từ danh sách mở thẳng màn chi tiết. Chi tiết mở Sửa khi phiếu còn nháp. Mọi màn: không đủ quyền → Không có quyền truy cập. Sai địa chỉ → Không tìm thấy trang." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontFamily=Arial;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20.0" y="1090.0" width="2100.0" height="48.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>