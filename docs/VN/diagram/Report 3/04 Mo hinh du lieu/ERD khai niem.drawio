<mxfile host="drawio"><diagram id="d" name="ERD khái niệm"><mxGraphModel grid="0" page="0" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="" style="rounded=1;arcSize=4;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.3;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry x="1065.0" y="370.0" width="980.0" height="208.0" as="geometry"/></mxCell><mxCell id="c3" value="Phiếu của trường, có vòng duyệt" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontStyle=3;fontFamily=Arial;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1375.0" y="374.0" width="360.0" height="30.0" as="geometry"/></mxCell><mxCell id="c4" value="mã quyền dạng&lt;br&gt;tài nguyên:hành động&lt;br&gt;hành động: xem, ghi, xoá,&lt;br&gt;duyệt, xuất" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.3;align=left;verticalAlign=top;spacingTop=30;spacingLeft=8;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40.0" y="130.0" width="250.0" height="124.0" as="geometry"/></mxCell><mxCell id="c5" value="Quyền" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.3;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;fontFamily=Arial;fillColor=#F8CECC;" vertex="1" parent="1"><mxGeometry x="40.0" y="130.0" width="250.0" height="32.0" as="geometry"/></mxCell><mxCell id="c6" value="mã vai trò&lt;br&gt;tên vai trò&lt;br&gt;mô tả&lt;br&gt;là vai trò hệ thống hay không" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.3;align=left;verticalAlign=top;spacingTop=30;spacingLeft=8;fontSize=15;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="380.0" y="130.0" width="250.0" height="124.0" as="geometry"/></mxCell><mxCell id="c7" value="Vai trò" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;strokeWidth=1.3;fontStyle=1;fontSize=15;align=center;verticalAlign=middle;