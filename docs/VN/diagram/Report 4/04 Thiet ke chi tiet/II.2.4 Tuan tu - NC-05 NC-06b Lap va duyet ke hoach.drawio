ent="1"><mxGeometry x="340.0" y="40.0" width="160.0" height="52.0" as="geometry"/></mxCell><mxCell id="c6" value=":ProcurementPlan&lt;br&gt;Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;fontFamily=Arial;spacing=2;" vertex="1" parent="1"><mxGeometry x="560.0" y="40.0" width="160.0" height="52.0" as="geometry"/></mxCell><mxCell id="c7" value=":VoucherWorkflow" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;fontFamily=Arial;spacing=2;" vertex="1" parent="1"><mxGeometry x="795.0" y="40.0" width="150.0" height="52.0" as="geometry"/></mxCell><mxCell id="c8" value="Repository /&lt;br&gt;CSDL PostgreSQL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;fontFamily=Arial;spacing=2;" vertex="1" parent="1"><mxGeometry x="1025.0" y="40.0" width="150.0" height="52.0" as="geometry"/></mxCell><mxCell id="c9" value="Phần b (NC-06). Duyệt và trả lại cần procurement_plans:approve (@PreAuthorize) và phải là lãnh đạo của chính cơ quan lập kế hoạch. Kế hoạch&lt;br&gt;có Duyệt và Trả lại, không có Từ chối. Không gửi thông báo." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF8DC;strokeColor=#000000;fontSize=12;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="360.0" y="108.0" width="815.0" height="42.0" as="geometry"/></mxCell><mxCell id="c99" value="Không có thông báo cho kế hoạch: VoucherWorkflow.complete() không phát sự kiện. Tiếp theo (NC-07): ở trường, POST /api/school/purchase_proposals/{id}/intake gọi&lt;br&gt;PurchaseProposalService.createIntake(), rồi EquipmentIntakeService.createFromPurchase() lập phiếu ghi tăng nháp theo số đưa vào kế hoạch." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF8DC;strokeColor=#000000;fontSize=12;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="155.0" y="1378.0" width="1020.0" height="42.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>