 bị sửa, đếm lại (Hình II.3.3b) rồi trình lại." style="shape=note;whiteSpace=nowrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=12;fontFamily=Arial;fillColor=#FFF8D6;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="520.0" y="696.0" width="630.0" height="42.0" as="geometry"/></mxCell><mxCell id="c105" value="REJECTED nằm ngoài InventoryFreeze.COUNTING: khoá được gỡ, hồ sơ thiết bị giữ nguyên. Trường lập phiếu&lt;br&gt;kiểm kê mới cho đợt được." style="shape=note;whiteSpace=nowrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=12;fontFamily=Arial;fillColor=#FFF8D6;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="520.0" y="1301.0" width="630.0" height="42.0" as="geometry"/></mxCell><mxCell id="c106" value="Lãnh đạo&lt;br&gt;trường" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;fontFamily=Arial;strokeColor=#000000;fillColor=#FFFFFF;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="27.0" y="2.0" width="26.0" height="44.0" as="geometry"/></mxCell><mxCell id="c107" value="«Giao diện»&lt;br&gt;InventorySessionShow&lt;br&gt;(VoucherActions)" style="rounded=0;whiteSpace=nowrap;html=1;fontSize=12;fontFamily=Arial;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="122.0" y="16.0" width="156.0" height="62.0" as="geometry"/></mxCell><mxCell id="c108" value=":InventorySession&lt;br&gt;Controller" style="rounded=0;whiteSpace=nowrap;html=1;fontSize=12;fontFamily=Arial;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="307.0" y="32.0" width="136.0" height="46.0" as="geometry"/></mxCell><mxCell id="c109" value=":InventorySession&lt;br&gt;Service" style="rounded=0;whiteSpace=nowrap;html=1;fontSize=12;fontFamily=Arial;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="477.0" y="32.0" width="136.0" height="46.0" as="geometry"/></mxCell><mxCell id="