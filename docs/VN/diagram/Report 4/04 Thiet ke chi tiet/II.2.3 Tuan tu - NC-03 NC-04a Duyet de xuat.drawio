ư&lt;br&gt;(SMTP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;fontFamily=Arial;spacing=2;" vertex="1" parent="1"><mxGeometry x="1170.0" y="40.0" width="100.0" height="52.0" as="geometry"/></mxCell><mxCell id="c12" value="NC-03: lãnh đạo trường duyệt bước SCHOOL qua /api/school/purchase_proposals. NC-04: lãnh đạo Sở duyệt bước MANAGING_BODY qua /api/so/purchase_proposals. Cả&lt;br&gt;hai cần mã quyền purchase_proposals:approve và phải thuộc đúng cấp của bước đang chờ (VoucherWorkflow.inTier). Phần a: mở phiếu và Đồng ý." style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#FFF8DC;strokeColor=#000000;fontSize=12;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="305.0" y="108.0" width="965.0" height="42.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>