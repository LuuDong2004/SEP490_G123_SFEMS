mit. Mỗi thông báo vừa lưu kèm một sự kiện&lt;br&gt;NotificationRaised, hai bộ nghe @TransactionalEventListener(AFTER_COMMIT) xử lý độc lập." style="shape=note;whiteSpace=nowrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=12;fontFamily=Arial;fillColor=#FFF8D6;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="8.0" y="96.0" width="560.0" height="42.0" as="geometry"/></mxCell><mxCell id="c53" value="Thư lỗi được retry() gửi lại sau RETRY_AFTER (5 phút), tối đa MAX_ATTEMPTS = 2 lần. Còn lỗi thì quản trị viên nhận cảnh&lt;br&gt;báo SYSTEM_ALERT, mỗi ngày một lần." style="shape=note;whiteSpace=nowrap;html=1;size=12;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=12;fontFamily=Arial;fillColor=#FFF8D6;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="380.0" y="775.0" width="700.0" height="42.0" as="geometry"/></mxCell><mxCell id="c54" value=":Notification&lt;br&gt;Service" style="rounded=0;whiteSpace=nowrap;html=1;fontSize=12;fontFamily=Arial;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="10.0" y="32.0" width="120.0" height="46.0" as="geometry"/></mxCell><mxCell id="c55" value=":Notification&lt;br&gt;Publisher" style="rounded=0;whiteSpace=nowrap;html=1;fontSize=12;fontFamily=Arial;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="190.0" y="32.0" width="120.0" height="46.0" as="geometry"/></mxCell><mxCell id="c56" value=":Notification&lt;br&gt;Mailer" style="rounded=0;whiteSpace=nowrap;html=1;fontSize=12;fontFamily=Arial;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="390.0" y="32.0" width="120.0" height="46.0" as="geometry"/></mxCell><mxCell id="c57" value="CSDL&lt;br&gt;(PostgreSQL)" style="rounded=0;whiteSpace=nowrap;html=1;fontSize=12;fontFamily=Arial;strokeColor=#000000;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="595.0" y="32.0" width="110.0" height="46.0" as="geometry"/></mxCell><mxCell id="c58" value=