{
  "$comment" : "SINH TỪ FieldRule / NumberRule / PasswordPolicy (backend) — không sửa tay, xem FieldRulesExportTest",
  "text" : {
    "CODE" : {
      "max" : 64,
      "pattern" : "^[A-Za-z0-9._-]*$",
      "message" : "chỉ gồm chữ không dấu, số, dấu chấm, gạch dưới, gạch nối"
    },
    "NAME" : {
      "max" : 255,
      "pattern" : "^(?=.*[\\p{L}\\p{N}])[^\\p{Cc}]*$",
      "message" : "phải có chữ hoặc số và không chứa ký tự điều khiển"
    },
    "PERSON_NAME" : {
      "max" : 100,
      "pattern" : "^[\\p{L}\\p{M}][\\p{L}\\p{M} .'-]*$",
      "message" : "chỉ gồm chữ cái, khoảng trắng, dấu nháy và gạch nối"
    },
    "SHORT_TEXT" : {
      "max" : 255,
      "pattern" : "^[^\\p{Cc}]*$",
      "message" : "không được chứa ký tự điều khiển"
    },
    "NOTE" : {
      "max" : 500,
      "pattern" : "^[^\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]*$",
      "message" : "không được chứa ký tự điều khiển"
    },
    "LONG_TEXT" : {
      "max" : 4000,
      "pattern" : "^[^\\x00-\\x08\\x0B\\x0C\\x0E-\\x1F\\x7F]*$",
      "message" : "không được chứa ký tự điều khiển"
    },
    "ADDRESS" : {
      "max" : 500,
      "pattern" : "^[^\\p{Cc}]*$",
      "message" : "không được chứa ký tự điều khiển"
    },
    "EMAIL" : {
      "max" : 254,
      "pattern" : "^$|^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}$",
      "message" : "không đúng định dạng (vd. ten@truong.edu.vn)"
    },
    "PHONE" : {
      "max" : 20,
      "pattern" : "^$|^(\\+84|0)[0-9]{9,10}$",
      "message" : "không hợp lệ (vd. 0912 345 678)",
      "strip" : "[ .()-]"
    },
    "TAX_CODE" : {
      "max" : 14,
      "pattern" : "^$|^[0-9]{10}(-[0-9]{3})?$",
      "message" : "không hợp lệ (10 số, chi nhánh thêm -3 số)"
    },
    "USERNAME" : {
      "max" : 64,
      "pattern" : "^[A-Za-z0-9._-]*$",
      "message" : "chỉ gồm chữ không dấu, số, dấu chấm, gạch dưới, gạch nối"
    },
    "URL" : {
      "max" : 500,
      "pattern" : "^$|^https?://[^\\s]+$",
      "message" : "phải bắt đầu bằng http:// hoặc https://"
    }
  },
  "number" : {
    "MONEY" : {
      "min" : 0,
      "max" : 100000000000,
      "scale" : 2
    },
    "QUANTITY" : {
      "min" : 1,
      "max" : 10000,
      "scale" : 0
    },
    "QUANTITY_OR_ZERO" : {
      "min" : 0,
      "max" : 10000,
      "scale" : 0
    },
    "DECIMAL_QUANTITY" : {
      "min" : 0,
      "max" : 1000000,
      "scale" : 3
    },
    "PERCENT" : {
      "min" : 0,
      "max" : 100,
      "scale" : 2
    },
    "COUNT" : {
      "min" : 0,
      "max" : 99999,
      "scale" : 0
    },
    "YEAR" : {
      "min" : 1950,
      "max" : null,
      "scale" : 0
    }
  },
  "date" : {
    "floor" : "1950-01-01",
    "ceiling" : "2100-12-31"
  },
  "password" : {
    "min" : 8,
    "privilegedMin" : 12,
    "max" : 128,
    "privilegedRoles" : [ "ADMIN", "SO_LEADER", "SO_SPECIALIST" ]
  }
}
